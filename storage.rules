// Incolla queste regole nel pannello "Storage → Regole" della Firebase Console.
// Lettura pubblica: le foto devono essere visibili a chiunque abbia il link all'albero
// (come i dati in Firestore). Scrittura riservata agli stessi account Google autorizzati
// a modificare l'albero (vedi firestore.rules per i dettagli e come aggiungerne altri:
// l'elenco email va tenuto allineato in entrambi i file).

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'pietrocarotighelli@gmail.com'
        ]
        && request.resource.size < 2 * 1024 * 1024   // margine di sicurezza: max 2 MB per foto
        && request.resource.contentType.matches('image/.*');
    }
  }
}
