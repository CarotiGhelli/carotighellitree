// Incolla queste regole nel pannello "Firestore → Regole" della Firebase Console.
// Lettura pubblica: chiunque abbia il link può GUARDARE l'albero senza accedere.
// Scrittura riservata: solo gli account Google elencati in ALLOWED_EDITOR_EMAILS
// possono modificare i dati. Questa è la protezione VERA (verificata dal server ad
// ogni richiesta): il controllo lato client in app.js serve solo a mostrare subito un
// messaggio chiaro, non basta da solo.
//
// Per aggiungere/togliere un familiare autorizzato: modifica l'elenco email qui sotto
// E l'elenco ALLOWED_EDITOR_EMAILS in app.js, poi incolla di nuovo queste regole qui.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isFamilyEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'pietrocarotighelli@gmail.com'
        ];
    }

    match /trees/{treeId} {
      allow read: if true;
      allow write: if isFamilyEditor();

      // Versioni salvate automaticamente ad ogni scrittura (vedi app.js: saveVersionSnapshot),
      // usate per "Ripristina" e come backup di recupero. Stessa protezione del documento principale.
      match /versions/{versionId} {
        allow read: if true;
        allow write: if isFamilyEditor();
      }
    }
  }
}
