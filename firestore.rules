// Incolla queste regole nel pannello "Firestore → Regole" della Firebase Console.
// Accesso pubblico: chiunque abbia il link può leggere e modificare l'albero.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /trees/{treeId} {
      allow read, write: if true;

      // Versioni salvate automaticamente ad ogni scrittura (vedi app.js: saveVersionSnapshot),
      // usate per "Ripristina" e come backup di recupero. Stesso livello di accesso del documento
      // principale.
      match /versions/{versionId} {
        allow read, write: if true;
      }
    }
  }
}
